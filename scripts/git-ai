#!/usr/bin/env bash
set -euo pipefail

for arg in "$@"; do
	case "$arg" in
	-h | -help | --help) exec git-cc-ai --help ;;
	esac
done

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

git_ai_cmd=(git-cc-ai "$@")

msg=$("${git_ai_cmd[@]}" 2> "$tmp") || { cat "$tmp" >&2; exit 1; }
cat "$tmp" >&2
echo "$msg" | git commit -F - --edit
